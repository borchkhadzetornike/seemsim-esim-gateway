# eSIM Gateway Configuration
# Copy to .env and fill in values

# Application
APP_NAME=esim-gateway
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://esim:esim_secret@localhost:5432/esim_gateway

# Redis
REDIS_URL=redis://localhost:6379/0

# eSIM Access Provider (from console.esimaccess.com/developer/index)
# API docs: docs.esimaccess.com
ESIM_ACCESS_BASE_URL=https://api.esimaccess.com
ESIM_ACCESS_ACCESS_CODE=your_access_code_here
ESIM_ACCESS_SECRET_KEY=your_secret_key_here

# Idempotency
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Provider Client
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3

# Background Tasks
CATALOG_SYNC_INTERVAL_SECONDS=3600
RECONCILIATION_INTERVAL_SECONDS=300
